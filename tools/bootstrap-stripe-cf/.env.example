# Copy to ~/.zshenv or load with direnv / 1Password shell plugin.
# Do NOT commit a filled-in copy of this file.

# The Stripe secret key for THIS project. Live keys start sk_live_,
# test keys start sk_test_. The script auto-detects mode from the prefix.
STRIPE_SECRET_KEY=sk_live_xxx

# Cloudflare API token with "Cloudflare Pages: Edit" permission.
# Mint at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=cf_xxx

# Your Cloudflare account id — visible bottom-right on any dash page.
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
